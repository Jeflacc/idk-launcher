{
  "name": "idk-launcher",
  "version": "2.0.0",
  "description": "Production-grade Minecraft launcher — feature-first Electron + TypeScript rewrite.",
  "author": "IDK Launcher Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-main/main/index.cjs",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n main,vite,electron -c green,cyan,magenta \"npm:dev:main\" \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:main": "node scripts/build-main.mjs --watch",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc -p tsconfig.node.json && node scripts/build-main.mjs && vite build",
    "build:main": "node scripts/build-main.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder --win --mac --linux"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/adm-zip": "^0.5.8",
    "@types/discord-rpc": "^4.0.11",
    "adm-zip": "^0.6.0",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "skinview3d": "^3.4.2",
    "sonner": "^2.0.7",
    "three": "^0.185.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.82.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "wait-on": "^9.0.10",
    "zustand": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
