{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "21st-magic": {
      "type": "local",
      "command": ["npx", "-y", "@21st-dev/magic@latest"],
      "enabled": false,
      "env": {
        "API_KEY": "bcc70be77b74740cc942349433809ace02ccc4335b96bfe251f4c4c188014565"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "D:\\Programming\\idk_launcher"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "npm *": "allow",
      "git *": "allow",
      "gh *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "*": "ask"
    }
  }
}
